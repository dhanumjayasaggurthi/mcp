server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  client_max_body_size 1m;
  include /etc/nginx/security-headers.conf;
  location /v1/ {
    proxy_pass ${API_UPSTREAM};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 40s;
    proxy_connect_timeout 5s;
    proxy_buffering off;
  }
  location = /readyz { proxy_pass ${API_UPSTREAM}; proxy_connect_timeout 5s; proxy_read_timeout 10s; }
  location = /livez { proxy_pass ${API_UPSTREAM}; proxy_connect_timeout 5s; proxy_read_timeout 10s; }
  location = /openapi.json { proxy_pass ${API_UPSTREAM}; }
  location = /console-health { access_log off; return 200 "ready\n"; }
  location = /runtime-config.js { include /etc/nginx/security-headers.conf; add_header Cache-Control "no-store"; try_files $uri =404; }
  location = /index.html { include /etc/nginx/security-headers.conf; add_header Cache-Control "no-store"; }
  location /assets/ { include /etc/nginx/security-headers.conf; add_header Cache-Control "public, max-age=31536000, immutable"; try_files $uri =404; }
  location / { try_files $uri $uri/ /index.html; }
}

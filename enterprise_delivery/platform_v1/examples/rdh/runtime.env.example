# Native PostgreSQL profile. Actual values belong in deployment configuration.
EDP_SECRET_DIR=/run/secrets/edp
EDP_CONTROL_DSN_REF=file://control-dsn
EDP_CURSOR_SECRET_REF=file://cursor-key
EDP_OIDC_ISSUER=https://REPLACE_WITH_ISSUER
EDP_OIDC_AUDIENCE=enterprise-data-platform
EDP_OIDC_JWKS_URL=https://REPLACE_WITH_JWKS_ENDPOINT
# Empty means optional backends are disabled. Add a registered real model
# endpoint + token + profiles to support query_text vector requests.
EDP_SEARCH_URL=
EDP_EMBEDDING_URL=
EDP_EXPORT_BUCKET=
EDP_RESOURCE_LIMITS={"max_seconds":30,"global_concurrency":200,"source_concurrency":20}
